.{
    .name = .zest,
    // Semantic version (https://semver.org/).
    .version = "0.1.1",
    // Globally unique package identifier, generated by the Zig toolchain when
    // the package was first created and then never changes.
    .fingerprint = 0x38a0093f7ac08c27, // Changing this has security and trust implications.
    // Tracks the earliest Zig version that the package considers to be a
    // supported use case.
    .minimum_zig_version = "0.16.0",

    // Pinned shared CLI presentation package.
    .dependencies = .{
        .dragonfruit = .{
            .url = "git+https://github.com/JustinWoodring/dragonfruit.git#48cbf880af923491d9661919ac53ad30fe69d628",
            .hash = "dragonfruit-0.1.0-mjPthIRcAAAlwWgsGPHsVcQgHvoPyJrzsC_CIPdSJf1v",
        },
    },

    // Files included in the package hash.
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        // The agent skill describing zest itself. zymposium links it when it
        // can find zest's source tree; without it the skill is simply absent.
        "skills",
        "LICENSE",
        "README.md",
    },
}
